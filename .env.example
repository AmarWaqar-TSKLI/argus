# Copy this file to .env and fill in what you have.
# Argus runs fine with NO keys at all (DOM-audit mode).
# Add a free Gemini key from https://aistudio.google.com/apikey to enable vision audits.

GOOGLE_API_KEY=
GROQ_API_KEY=

# Where Playwright downloads Chromium (keep it off C:)
PLAYWRIGHT_BROWSERS_PATH=D:\playwright-browsers
